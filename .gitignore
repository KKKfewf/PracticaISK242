# Windows
# =============================================
# Windows (основная ОС разработки)
# =============================================
Thumbs.db          # Миниатюры изображений
desktop.ini        # Настройки отображения папки
$RECYCLE.BIN/      # Корзина (целиком папка)
*.tmp              # Любые временные файлы
*.temp

# =============================================
# macOS (на случай, если кто-то откроет репо на Mac)
# =============================================
.DS_Store
.AppleDouble
.LSOverride

# =============================================
# Linux
# =============================================
*~                 # Резервные копии в редакторах (vim, nano)
.swp               # Файлы подкачки vim

# =============================================
# Среды разработки (IDE)
# =============================================
# VS Code (используется вами)
.vscode/           # Папка с настройками рабочей области
*.code-workspace   # Файл мультикорневой области

# JetBrains (если вдруг перейдёте)
.idea/
*.iml

# Visual Studio (не используется, но для полноты)
bin/
obj/
*.suo
*.user

# =============================================
# Логи и временные папки
# =============================================
*.log              # Все файлы с расширением .log
logs/              # Папка logs/ целиком
temp/
tmp/

# =============================================
# Офисные документы (временные копии)
# =============================================
~$*.docx
~$*.xlsx

# =============================================
# Диаграммы (если будете экспортировать временные файлы)
# =============================================
*.bak
*.tmp_diagram